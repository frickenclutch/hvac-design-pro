{
  "name": "hvac-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "scope:check": "node scripts/check-tenant-scoping.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 execute hvac-design-pro --file=./migrations/0001_init.sql",
    "db:migrate:dev": "wrangler d1 execute hvac-design-pro-dev --file=./migrations/0001_init.sql --local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "hono": "^4.7.0",
    "itty-router": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.14",
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.80.0"
  }
}
